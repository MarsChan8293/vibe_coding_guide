---
interface Source {
  label: string;
  href: string;
}

interface Event {
  date: string;
  title: string;
  concept: string;
  summary: string;
  impact: string;
  question: string;
  sources: Source[];
}

interface Props {
  events: Event[];
}

const { events } = Astro.props;
---

<ol class="timeline" aria-label="2025 年至今的 Vibe Coding 时间轴">
  {events.map((event, index) => (
    <li>
      <div class="event-rail">
        <span class="event-index">{String(index + 1).padStart(2, "0")}</span>
        <time class="event-date">{event.date}</time>
      </div>
      <span class="event-node" aria-hidden="true"></span>
      <details open={index === 1 || index === events.length - 1}>
        <summary>
          <strong>{event.title}</strong>
          <span class="event-concept">{event.concept}</span>
        </summary>
        <div class="event-body">
          <p>{event.summary}</p>
          <dl>
            <div>
              <dt>为什么重要</dt>
              <dd>{event.impact}</dd>
            </div>
            <div>
              <dt>留下的问题</dt>
              <dd>{event.question}</dd>
            </div>
          </dl>
          <p class="event-sources">
            {event.sources.map((source) => (
              <a href={source.href} target="_blank" rel="noreferrer">{source.label} ↗</a>
            ))}
          </p>
        </div>
      </details>
    </li>
  ))}
</ol>

<style>
  .timeline {
    display: grid;
    width: min(960px, calc(100vw - 3rem));
    margin: 4rem 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: 9.5rem 2.5rem minmax(0, 1fr);
    padding-bottom: 2rem;
  }

  .timeline li::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 10.7rem;
    width: 1px;
    content: "";
    background: var(--line);
  }

  .timeline li:first-child::before {
    top: 1.5rem;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li:last-child::before {
    bottom: auto;
    height: 1.5rem;
  }

  .event-rail {
    display: grid;
    align-content: start;
    justify-items: end;
    padding: .75rem 1.2rem 0 0;
    text-align: right;
  }

  .event-index {
    color: var(--red);
    font: 760 2.35rem/1 var(--serif);
  }

  .event-date {
    margin-top: .45rem;
    color: var(--muted);
    font: 650 .78rem/1.5 var(--mono);
    white-space: nowrap;
  }

  .event-node {
    z-index: 1;
    display: block;
    width: .95rem;
    height: .95rem;
    margin-top: 1.05rem;
    place-self: start center;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 1px var(--red);
  }

  details {
    min-width: 0;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.23);
    box-shadow: 6px 6px 0 rgba(24, 24, 21, .045);
  }

  summary {
    display: grid;
    min-height: 108px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .55rem 1.25rem;
    padding: 1.25rem 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    grid-column: 2;
    grid-row: 1;
    content: "+";
    font: 500 1.5rem/1 var(--mono);
  }

  details[open] summary::after {
    content: "−";
  }

  .event-concept {
    font-family: var(--mono);
  }

  summary strong {
    min-width: 0;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .event-concept {
    grid-column: 1;
    grid-row: 2;
    color: var(--muted);
    font-size: .75rem;
    line-height: 1.6;
  }

  .event-body {
    padding: .2rem 1.4rem 1.4rem;
    border-top: 1px solid var(--soft-line);
  }

  details[open] .event-body {
    animation: reveal .22s ease-out;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  dt {
    color: var(--red-dark);
    font: 700 .65rem/1 var(--mono);
    letter-spacing: .08em;
  }

  dd {
    margin: .45rem 0 0;
  }

  .event-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font: 650 .75rem/1.5 var(--mono);
  }

  @media (max-width: 680px) {
    .timeline {
      width: 100%;
      margin-block: 3rem;
    }

    .timeline li {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      padding-bottom: 1.75rem;
    }

    .timeline li::before {
      left: .45rem;
    }

    .event-rail {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      align-items: baseline;
      justify-content: start;
      gap: .7rem;
      padding: 0 0 .65rem;
      text-align: left;
    }

    .event-index {
      font-size: 1.65rem;
    }

    .event-date {
      margin-top: 0;
    }

    .event-node {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-top: .38rem;
    }

    details {
      grid-column: 2;
      grid-row: 2;
    }

    summary {
      min-height: 0;
      padding: 1rem;
    }

    summary strong {
      font-size: 1.08rem;
    }

    .event-body {
      padding: .15rem 1rem 1rem;
    }

    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
