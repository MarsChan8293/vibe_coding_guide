---
interface Props {
  lessonId: string;
}
const { lessonId } = Astro.props;
---

<button class="progress-toggle" type="button" data-lesson-toggle={lessonId} aria-pressed="false">
  <span class="box" aria-hidden="true"></span>
  <span data-label>标记本课已完成</span>
</button>

<style>
  .progress-toggle {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: .7rem;
    padding: .7rem 1rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    background: transparent;
    font: 700 .75rem/1.2 var(--mono);
    cursor: pointer;
  }

  .box {
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid currentColor;
  }

  .progress-toggle[aria-pressed="true"] {
    color: var(--paper);
    background: var(--olive);
  }

  .progress-toggle[aria-pressed="true"] .box::after {
    display: block;
    color: white;
    content: "✓";
    font: 700 .9rem/1 var(--sans);
    text-align: center;
  }
</style>
