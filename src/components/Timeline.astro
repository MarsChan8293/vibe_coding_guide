---
interface Source {
  label: string;
  href: string;
}

interface TrackEvent {
  title: string;
  concept: string;
  summary: string;
  impact: string;
  question: string;
  sources: Source[];
}

interface TimelineEvent {
  date: string;
  sort: string;
  model?: TrackEvent;
  agent?: TrackEvent;
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<section class="timeline-wrap" aria-labelledby="timeline-title">
  <header class="timeline-heading">
    <p class="eyebrow">TWO TRACKS / ONE SHIFT</p>
    <h2 id="timeline-title">模型能力，与行动能力</h2>
    <p>从模型发布到工具形态，观察 AI 编程如何一步步走向可执行、可复用的工程协作。</p>
  </header>

  <div class="track-labels" aria-hidden="true">
    <span>模型发布</span>
    <span>时间</span>
    <span>工具 / Agent</span>
  </div>

  <ol class="timeline" aria-label="2025 年至今的模型与 AI 工具时间轴">
  {events.map((event, index) => (
    <li>
      {event.model && (
      <details class="event-card model-card" open={index === 0 || index === events.length - 1}>
        <summary>
          <span class="track-kicker">模型发布</span>
          <strong>{event.model.title}</strong>
          <span class="event-concept">{event.model.concept}</span>
        </summary>
        <div class="event-body">
          <p>{event.model.summary}</p>
          <dl>
            <div>
              <dt>为什么重要</dt>
              <dd>{event.model.impact}</dd>
            </div>
            <div>
              <dt>留下的问题</dt>
              <dd>{event.model.question}</dd>
            </div>
          </dl>
          <p class="event-sources">
            {event.model.sources.map((source) => (
              <a href={source.href} target="_blank" rel="noreferrer">{source.label} ↗</a>
            ))}
          </p>
        </div>
      </details>
      )}
      <div class="event-rail">
        <span class="event-index">{String(index + 1).padStart(2, "0")}</span>
        <time class="event-date" datetime={event.sort}>{event.date}</time>
        <span class="event-node" aria-hidden="true"></span>
      </div>
      {event.agent && (
      <details class="event-card agent-card" open={index === 0 || index === events.length - 1}>
        <summary>
          <span class="track-kicker">工具 / Agent</span>
          <strong>{event.agent.title}</strong>
          <span class="event-concept">{event.agent.concept}</span>
        </summary>
        <div class="event-body">
          <p>{event.agent.summary}</p>
          <dl>
            <div>
              <dt>为什么重要</dt>
              <dd>{event.agent.impact}</dd>
            </div>
            <div>
              <dt>留下的问题</dt>
              <dd>{event.agent.question}</dd>
            </div>
          </dl>
          <p class="event-sources">
            {event.agent.sources.map((source) => (
              <a href={source.href} target="_blank" rel="noreferrer">{source.label} ↗</a>
            ))}
          </p>
        </div>
      </details>
      )}
    </li>
  ))}
  </ol>
</section>

<style>
  .timeline-wrap {
    width: min(1180px, 100%);
    margin: 4rem 0;
  }

  .timeline-heading {
    width: min(640px, 100%);
    margin-bottom: 2.25rem;
  }

  .eyebrow,
  .track-labels,
  .track-kicker {
    color: var(--red-dark);
    font: 700 .68rem/1.2 var(--mono);
    letter-spacing: .08em;
  }

  .timeline-heading h2 {
    margin: .65rem 0 .75rem;
    font: 700 clamp(2rem, 4.5vw, 3.75rem)/.98 var(--serif);
    letter-spacing: -.04em;
  }

  .timeline-heading p:last-child {
    margin: 0;
    color: var(--muted);
  }

  .track-labels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8.5rem minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0 0 .85rem;
    padding: 0 .25rem;
  }

  .track-labels span:nth-child(2) {
    text-align: center;
  }

  .track-labels span:last-child {
    text-align: right;
  }

  .timeline {
    display: grid;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) 8.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  .timeline li::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - .5px);
    width: 1px;
    content: "";
    background: var(--line);
  }

  .timeline li:first-child::before {
    top: 3rem;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li:last-child::before {
    bottom: auto;
    height: 3rem;
  }

  .event-rail {
    grid-column: 2;
    display: grid;
    align-content: start;
    justify-items: center;
    padding: .35rem 0 0;
    text-align: right;
  }

  .event-index {
    color: var(--red);
    font: 760 2.35rem/1 var(--serif);
  }

  .event-date {
    margin-top: .45rem;
    color: var(--muted);
    font: 650 .78rem/1.5 var(--mono);
    text-align: center;
  }

  .event-node {
    z-index: 1;
    display: block;
    width: .95rem;
    height: .95rem;
    margin-top: .85rem;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 1px var(--red);
  }

  .event-card {
    min-width: 0;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.23);
    box-shadow: 6px 6px 0 rgba(24, 24, 21, .045);
  }

  summary {
    display: grid;
    min-height: 134px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .55rem 1.25rem;
    padding: 1.25rem 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    grid-column: 2;
    grid-row: 1 / span 2;
    content: "+";
    font: 500 1.5rem/1 var(--mono);
  }

  details[open] summary::after {
    content: "−";
  }

  summary strong {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .event-concept {
    grid-column: 1;
    grid-row: 3;
    color: var(--muted);
    font-size: .75rem;
    line-height: 1.6;
  }

  .event-body {
    padding: .2rem 1.4rem 1.4rem;
    border-top: 1px solid var(--soft-line);
  }

  .event-card[open] .event-body {
    animation: reveal .22s ease-out;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  dt {
    color: var(--red-dark);
    font: 700 .65rem/1 var(--mono);
    letter-spacing: .08em;
  }

  dd {
    margin: .45rem 0 0;
  }

  .event-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font: 650 .75rem/1.5 var(--mono);
  }

  .model-card {
    grid-column: 1;
  }

  .agent-card {
    grid-column: 3;
  }

  .model-card .track-kicker {
    color: var(--red-dark);
  }

  .agent-card .track-kicker {
    color: var(--ink);
  }

  @media (max-width: 680px) {
    .timeline-wrap {
      margin-block: 3rem;
    }

    .track-labels {
      display: none;
    }

    .timeline li {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0 .8rem;
      padding-bottom: 1.75rem;
    }

    .timeline li::before {
      left: .45rem;
    }

    .event-rail {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      align-items: baseline;
      justify-content: start;
      gap: .7rem;
      padding: 0 0 .65rem;
      text-align: left;
    }

    .event-index {
      font-size: 1.65rem;
    }

    .event-date {
      margin-top: 0;
      text-align: left;
    }

    .event-node {
      grid-column: 1;
      grid-row: 1 / span 3;
      margin-top: .38rem;
    }

    .event-card {
      grid-column: 2;
    }

    .model-card {
      grid-row: 2;
      margin-bottom: .75rem;
    }

    .agent-card {
      grid-row: 3;
    }

    summary {
      min-height: 0;
      padding: 1rem;
    }

    summary strong {
      font-size: 1.08rem;
    }

    .event-body {
      padding: .15rem 1rem 1rem;
    }

    dl {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card[open] .event-body {
      animation: none;
    }
  }
</style>
