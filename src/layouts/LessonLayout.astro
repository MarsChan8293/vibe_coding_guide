---
import type { LessonEntry } from "../lib/site";
import BaseLayout from "./BaseLayout.astro";
import ProgressToggle from "../components/ProgressToggle.astro";
import { lessonPath, sections, TOTAL_LESSONS } from "../lib/site";

interface Props {
  entry: LessonEntry;
  allLessons: LessonEntry[];
}

const { entry, allLessons } = Astro.props;
const section = sections[entry.data.section];
const sectionLessons = allLessons
  .filter((lesson) => lesson.data.section === entry.data.section)
  .sort((a, b) => a.data.order - b.data.order);
const index = sectionLessons.findIndex((lesson) => lesson.id === entry.id);
const previous = sectionLessons[index - 1];
const next = sectionLessons[index + 1];
const lessonId = entry.id.replace(/\.(md|mdx)$/, "");
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="lesson-shell site-shell">
    <aside class="lesson-sidebar" aria-label={`${section.label}目录`}>
      <p class="sidebar-section"><span>{section.index}</span>{section.label}</p>
      <ol>
        {sectionLessons.map((lesson) => (
          <li class:list={{ current: lesson.id === entry.id }}>
            <a href={lessonPath(lesson)}>
              <span>{String(lesson.data.order).padStart(2, "0")}</span>
              {lesson.data.title}
            </a>
          </li>
        ))}
      </ol>
      <div
        class="sidebar-progress"
        data-progress-bar
        role="progressbar"
        aria-label="全课程完成进度"
        aria-valuemin="0"
        aria-valuemax={TOTAL_LESSONS}
        aria-valuenow="0"
      >
        <span>课程进度</span>
        <strong data-progress-count>0/{TOTAL_LESSONS}</strong>
      </div>
      <button class="sidebar-reset" type="button" data-progress-reset>重置本地进度</button>
    </aside>

    <article class="lesson-article">
      <header class="lesson-header">
        <p class="eyebrow">{section.label} · Lesson {String(entry.data.order).padStart(2, "0")}</p>
        <h1>{entry.data.title}</h1>
        <p class="lesson-deck">{entry.data.description}</p>
        <div class="lesson-meta">
          <span>约 {entry.data.estimatedMinutes} 分钟</span>
          <span>{entry.data.tags.join(" / ")}</span>
        </div>
        <div class="outcomes">
          <p>完成后你能：</p>
          <ul>
            {entry.data.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="lesson-footer">
        <ProgressToggle lessonId={lessonId} />
        <nav aria-label="课程翻页">
          {previous ? (
            <a href={lessonPath(previous)}>
              <span>上一篇</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : <span />}
          {next ? (
            <a href={lessonPath(next)}>
              <span>下一篇</span>
              <strong>{next.data.title}</strong>
            </a>
          ) : <span />}
        </nav>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .lesson-shell {
    display: grid;
    grid-template-columns: 255px minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 8rem);
    padding-top: 4rem;
  }

  .lesson-sidebar {
    position: sticky;
    top: 106px;
    height: calc(100vh - 130px);
    overflow-y: auto;
    padding-right: 1rem;
    border-right: 1px solid var(--line);
  }

  .sidebar-section {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    margin: 0 0 1.3rem;
    font: 750 .75rem/1 var(--mono);
  }

  .sidebar-section span {
    color: var(--red);
    font-size: 2rem;
  }

  .lesson-sidebar ol {
    display: grid;
    margin: 0;
    padding: 0;
    gap: .12rem;
    list-style: none;
  }

  .lesson-sidebar a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: .45rem;
    padding: .58rem .5rem;
    border-left: 2px solid transparent;
    font-size: .78rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .lesson-sidebar a span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: .65rem;
  }

  .lesson-sidebar .current a {
    border-left-color: var(--red);
    background: rgba(201,66,44,.08);
    font-weight: 750;
  }

  .sidebar-progress {
    --progress: 0%;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    background: linear-gradient(90deg, var(--red) var(--progress), var(--line) 0) top/100% 3px no-repeat;
    font: .68rem/1 var(--mono);
  }

  .sidebar-progress strong {
    float: right;
  }

  .sidebar-reset {
    margin-top: 1rem;
    padding: 0;
    border: 0;
    color: var(--muted);
    background: transparent;
    font: 650 .66rem/1 var(--mono);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: .22rem;
  }

  .lesson-article {
    min-width: 0;
    max-width: 1050px;
  }

  .lesson-header {
    position: relative;
    max-width: 980px;
    margin-bottom: 4rem;
    padding-bottom: 2.7rem;
    border-bottom: 1px solid var(--ink);
  }

  .lesson-header h1 {
    max-width: 900px;
    margin: 0;
    font: 760 clamp(2.7rem, 7vw, 6.6rem)/.99 var(--serif);
    letter-spacing: -.045em;
    text-wrap: balance;
  }

  .lesson-deck {
    max-width: 720px;
    margin: 1.6rem 0;
    color: #3c3932;
    font: 500 clamp(1.05rem, 2vw, 1.35rem)/1.7 var(--serif);
  }

  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem 1.5rem;
    color: var(--muted);
    font: .68rem/1.4 var(--mono);
  }

  .outcomes {
    max-width: 720px;
    margin-top: 2.4rem;
    padding: 1.15rem 1.4rem;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.22);
  }

  .outcomes p {
    margin: 0 0 .5rem;
    color: var(--red-dark);
    font: 750 .7rem/1 var(--mono);
  }

  .outcomes ul {
    margin: 0;
    padding-left: 1.2rem;
    columns: 2;
    font-size: .86rem;
  }

  .lesson-footer {
    max-width: var(--measure);
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--ink);
  }

  .lesson-footer nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 2.5rem;
    gap: 1rem;
  }

  .lesson-footer nav a {
    display: grid;
    padding: 1rem;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .lesson-footer nav a:last-child {
    text-align: right;
  }

  .lesson-footer nav span {
    color: var(--red-dark);
    font: .65rem/1 var(--mono);
  }

  .lesson-footer nav strong {
    margin-top: .45rem;
    font-family: var(--serif);
  }

  @media (max-width: 980px) {
    .lesson-shell {
      grid-template-columns: 1fr;
      padding-top: 2rem;
    }

    .lesson-sidebar {
      position: static;
      height: auto;
      overflow: visible;
      padding: 0 0 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .lesson-sidebar ol {
      display: flex;
      overflow-x: auto;
      padding-bottom: .5rem;
    }

    .lesson-sidebar li {
      flex: 0 0 190px;
    }

    .sidebar-progress {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .lesson-header h1 {
      font-size: clamp(2.35rem, 14vw, 4rem);
    }

    .outcomes ul {
      columns: 1;
    }

    .lesson-footer nav {
      grid-template-columns: 1fr;
    }

    .lesson-footer nav a:last-child {
      text-align: left;
    }
  }
</style>
